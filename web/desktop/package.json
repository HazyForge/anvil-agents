{
  "name": "anvil-agents-desktop",
  "productName": "Anvil Agents Desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "electron": "electron electron/main.mjs",
    "dist:win": "electron-builder --win zip nsis --x64",
    "dist:linux": "electron-builder --linux dir --x64"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "electron": "^44.3.0",
    "typescript": "~5.8.3",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "io.hazyforge.anvil-agents-desktop",
    "productName": "Anvil Agents Desktop",
    "copyright": "Copyright © Hazy Forge",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../dist/desktop/sidecar",
        "to": "sidecar",
        "filter": ["anvil-desktop*"]
      }
    ],
    "win": {
      "target": ["zip", "nsis"],
      "artifactName": "Anvil-Agents-Desktop-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Anvil Agents Desktop",
      "uninstallDisplayName": "Anvil Agents Desktop",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["dir"],
      "artifactName": "Anvil-Agents-Desktop-${version}-${os}-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
