#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage:
  anvil-agent-status [type] [flags]

Types:
  progress        Record an intermediate status report.
  decision        Record the final classification/action decision.
  needsHuman      Record that human follow-up is required.
  effect-started  Record an external mutation attempt before dispatch.
  effect-confirmed
                  Record an external mutation confirmed by provider readback.
  effect-failed   Record a provider-confirmed mutation failure.
  effect-summary  Record the run's external-effect ledger completeness.

Flags:
  --type VALUE
  --level VALUE
  --stage VALUE
  --classification VALUE
  --action VALUE
  --summary VALUE
  --detail VALUE
  --pull-request-url VALUE
  --pr-url VALUE
  --residual-risk VALUE
  --human-follow-up VALUE
  --needs-human
  --operation-id VALUE
  --effect-kind VALUE
  --target VALUE
  --intent-digest VALUE
  --input-digest VALUE
  --idempotency-key VALUE
  --external-ref VALUE
  --external-url VALUE
  --actor VALUE
  --executor VALUE
  --completeness VALUE
EOF
}

need_value() {
	if [[ $# -lt 2 || "${2:-}" == --* ]]; then
		echo "missing value for $1" >&2
		exit 2
	fi
}

report_type="progress"
if [[ $# -gt 0 && "${1:-}" != --* ]]; then
	report_type="$1"
	shift
fi

effect_state=""
level="info"
stage=""
classification=""
action=""
summary=""
detail=""
pull_request_url=""
residual_risk=""
human_follow_up=""
needs_human=false
operation_id=""
effect_kind=""
target=""
intent_digest=""
input_digest=""
idempotency_key=""
external_ref=""
external_url=""
actor="${ANVIL_AGENT_RUN_EFFECT_ACTOR:-}"
executor="${ANVIL_AGENT_RUN_EFFECT_EXECUTOR:-}"
effect_completeness=""

while [[ $# -gt 0 ]]; do
	case "$1" in
		--type)
			need_value "$@"
			report_type="$2"
			shift 2
			;;
		--level)
			need_value "$@"
			level="$2"
			shift 2
			;;
		--stage)
			need_value "$@"
			stage="$2"
			shift 2
			;;
		--classification)
			need_value "$@"
			classification="$2"
			shift 2
			;;
		--action)
			need_value "$@"
			action="$2"
			shift 2
			;;
		--summary)
			need_value "$@"
			summary="$2"
			shift 2
			;;
		--detail)
			need_value "$@"
			detail="$2"
			shift 2
			;;
		--pull-request-url|--pr-url)
			need_value "$@"
			pull_request_url="$2"
			shift 2
			;;
		--residual-risk)
			need_value "$@"
			residual_risk="$2"
			shift 2
			;;
		--human-follow-up)
			need_value "$@"
			human_follow_up="$2"
			shift 2
			;;
		--needs-human)
			needs_human=true
			shift
			;;
		--operation-id)
			need_value "$@"
			operation_id="$2"
			shift 2
			;;
		--effect-kind)
			need_value "$@"
			effect_kind="$2"
			shift 2
			;;
		--target)
			need_value "$@"
			target="$2"
			shift 2
			;;
		--intent-digest)
			need_value "$@"
			intent_digest="$2"
			shift 2
			;;
		--input-digest)
			need_value "$@"
			input_digest="$2"
			shift 2
			;;
		--idempotency-key)
			need_value "$@"
			idempotency_key="$2"
			shift 2
			;;
		--external-ref)
			need_value "$@"
			external_ref="$2"
			shift 2
			;;
		--external-url)
			need_value "$@"
			external_url="$2"
			shift 2
			;;
		--actor)
			need_value "$@"
			actor="$2"
			shift 2
			;;
		--executor)
			need_value "$@"
			executor="$2"
			shift 2
			;;
		--completeness)
			need_value "$@"
			effect_completeness="$2"
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			if [[ -z "${summary}" ]]; then
				summary="$1"
			else
				summary="${summary} $1"
			fi
			shift
			;;
	esac
done

case "${report_type}" in
	effect-started)
		report_type="effect"
		effect_state="Started"
		;;
	effect-confirmed)
		report_type="effect"
		effect_state="Confirmed"
		;;
	effect-failed)
		report_type="effect"
		effect_state="Failed"
		;;
	effect-summary)
		report_type="effectSummary"
		;;
esac

if [[ "${report_type}" == "needsHuman" || "${report_type}" == "needs-human" ]]; then
	report_type="needsHuman"
	needs_human=true
fi

if [[ "${report_type}" == "effect" ]]; then
	case "${effect_state}" in
		Started|Confirmed|Failed) ;;
		*)
			echo "external-effect state is selected with effect-started, effect-confirmed, or effect-failed" >&2
			exit 2
			;;
	esac
	for required in operation_id effect_kind target intent_digest input_digest idempotency_key; do
		if [[ -z "${!required}" ]]; then
			echo "${required//_/-} is required for external-effect receipts" >&2
			exit 2
		fi
	done
	if [[ "${effect_state}" == "Confirmed" && -z "${external_ref}" ]]; then
		echo "external-ref is required for confirmed external-effect receipts" >&2
		exit 2
	fi
	if [[ "${effect_state}" == "Failed" && -z "${summary}" && -z "${detail}" ]]; then
		echo "summary or detail is required for failed external-effect receipts" >&2
		exit 2
	fi
fi

if [[ "${report_type}" == "effectSummary" ]]; then
	case "${effect_completeness}" in
		Complete|Incomplete|Unknown) ;;
		*)
			echo "completeness must be Complete, Incomplete, or Unknown" >&2
			exit 2
			;;
	esac
fi

observed_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
json="$(
	jq -cn \
		--arg type "${report_type}" \
		--arg observedAt "${observed_at}" \
		--arg level "${level}" \
		--arg stage "${stage}" \
		--arg classification "${classification}" \
		--arg action "${action}" \
		--arg summary "${summary}" \
		--arg detail "${detail}" \
		--arg pullRequestURL "${pull_request_url}" \
		--arg residualRisk "${residual_risk}" \
		--arg humanFollowUp "${human_follow_up}" \
		--argjson needsHuman "${needs_human}" \
		--arg effectState "${effect_state}" \
		--arg operationID "${operation_id}" \
		--arg effectKind "${effect_kind}" \
		--arg target "${target}" \
		--arg intentDigest "${intent_digest}" \
		--arg inputDigest "${input_digest}" \
		--arg idempotencyKey "${idempotency_key}" \
		--arg externalRef "${external_ref}" \
		--arg externalURL "${external_url}" \
		--arg actor "${actor}" \
		--arg executor "${executor}" \
		--arg completeness "${effect_completeness}" \
		'{
			type: $type,
			observedAt: $observedAt,
			level: $level,
			stage: $stage,
			classification: $classification,
			action: $action,
			summary: $summary,
			detail: $detail,
			pullRequestURL: $pullRequestURL,
			residualRisk: $residualRisk,
			needsHuman: $needsHuman,
			humanFollowUp: $humanFollowUp,
			effect: (if $type == "effect" then ({
				operationID: $operationID,
				kind: $effectKind,
				state: $effectState,
				target: $target,
				intentDigest: $intentDigest,
				inputDigest: $inputDigest,
				idempotencyKey: $idempotencyKey,
				externalRef: $externalRef,
				externalURL: $externalURL,
				actor: $actor,
				executor: $executor,
				startedAt: (if $effectState == "Started" then $observedAt else "" end),
				completedAt: (if ($effectState == "Confirmed" or $effectState == "Failed") then $observedAt else "" end),
				verifiedAt: (if $effectState == "Confirmed" then $observedAt else "" end),
				message: (if $summary != "" then $summary else $detail end)
			} | with_entries(select(.value != "" and .value != false and .value != null))) else null end),
			effectSummary: (if $type == "effectSummary" then {
				completeness: $completeness,
				summary: $summary
			} | with_entries(select(.value != "" and .value != false and .value != null)) else null end)
		} | with_entries(select(.value != "" and .value != false and .value != null))'
)"

status_file="${ANVIL_AGENT_RUN_STATUS_FILE:-/tmp/anvil-agent-run-status/status.jsonl}"
mkdir -p "$(dirname "${status_file}")"
printf '%s\n' "${json}" >> "${status_file}"

prefix="${ANVIL_AGENT_RUN_STATUS_LOG_PREFIX:-ANVIL_AGENT_RUN_STATUS_JSON=}"
log_fd="${ANVIL_AGENT_RUN_STATUS_LOG_FD:-/proc/1/fd/1}"
if [[ -n "${log_fd}" && -w "${log_fd}" ]]; then
	printf '%s%s\n' "${prefix}" "${json}" > "${log_fd}" || true
fi

printf 'agent status recorded: %s\n' "${summary:-${report_type}}"
