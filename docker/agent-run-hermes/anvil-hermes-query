#!/usr/bin/env python3
"""Run Hermes quiet single-query chat with the query body loaded from a file.

Hermes CLI only accepts `-q` / `--query` as an in-process string for quiet
single-shot mode. Passing the merged AgentRun prompt through shell expansion
(`hermes chat -q "$(cat …)"`) places the full prompt on process argv, which is
visible to other processes on the node via `ps` / `/proc`.

This helper keeps only the prompt *path* on argv. The query body is read from
disk and passed into Hermes in-process via `cli.main(query=..., quiet=True)`,
matching the path used by `hermes_cli.main.cmd_chat` after argparse. The native
run_conversation result supplies the final answer; terminal display output is
suppressed and stdout contains only a versioned anvil.hermes.final envelope.

Usage:
  anvil-hermes-query <prompt-file>

Optional environment:
  ANVIL_HERMES_ADDITIONAL_ARGS_JSON  JSON array of extra hermes chat flags
                                     (for example model/provider overrides).
                                     -q/--query values are ignored so the file
                                     always wins.
"""

from __future__ import annotations

import contextlib
import functools
import json
import os
import sys
from pathlib import Path
from typing import Any


def _load_additional_kwargs() -> dict[str, Any]:
    """Map a small set of hermes chat flags from ADDITIONAL_ARGS_JSON to kwargs."""
    raw = os.environ.get("ANVIL_HERMES_ADDITIONAL_ARGS_JSON", "").strip()
    if not raw:
        return {}
    try:
        items = json.loads(raw)
    except json.JSONDecodeError as exc:
        print(
            f"anvil-hermes-query: invalid ANVIL_HERMES_ADDITIONAL_ARGS_JSON: {exc}",
            file=sys.stderr,
        )
        sys.exit(2)
    if not isinstance(items, list):
        print(
            "anvil-hermes-query: ANVIL_HERMES_ADDITIONAL_ARGS_JSON must be a JSON array",
            file=sys.stderr,
        )
        sys.exit(2)

    kwargs: dict[str, Any] = {}
    unknown: list[str] = []
    i = 0
    while i < len(items):
        arg = items[i]
        if not isinstance(arg, str):
            i += 1
            continue
        if arg in ("-q", "--query") or arg.startswith("--query="):
            # File-backed query always wins; skip any provided query body.
            if arg in ("-q", "--query") and i + 1 < len(items):
                i += 2
            else:
                i += 1
            continue
        if arg in ("--quiet", "-Q"):
            kwargs["quiet"] = True
            i += 1
            continue
        if arg in ("--verbose", "-v"):
            kwargs["verbose"] = True
            i += 1
            continue
        if arg in ("--model", "-m") and i + 1 < len(items):
            kwargs["model"] = str(items[i + 1])
            i += 2
            continue
        if arg.startswith("--model="):
            kwargs["model"] = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--provider" and i + 1 < len(items):
            kwargs["provider"] = str(items[i + 1])
            i += 2
            continue
        if arg.startswith("--provider="):
            kwargs["provider"] = arg.split("=", 1)[1]
            i += 1
            continue
        if arg in ("--toolsets", "-t") and i + 1 < len(items):
            kwargs["toolsets"] = str(items[i + 1])
            i += 2
            continue
        if arg.startswith("--toolsets="):
            kwargs["toolsets"] = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--skills" and i + 1 < len(items):
            kwargs["skills"] = str(items[i + 1])
            i += 2
            continue
        if arg.startswith("--skills="):
            kwargs["skills"] = arg.split("=", 1)[1]
            i += 1
            continue
        if arg == "--max-turns" and i + 1 < len(items):
            kwargs["max_turns"] = int(items[i + 1])
            i += 2
            continue
        if arg.startswith("--max-turns="):
            kwargs["max_turns"] = int(arg.split("=", 1)[1])
            i += 1
            continue
        if arg in ("--yolo",):
            os.environ["HERMES_YOLO_MODE"] = "1"
            i += 1
            continue
        # Fail closed: do not silently drop or reintroduce args on argv.
        unknown.append(arg)
        i += 1
    if unknown:
        print(
            "anvil-hermes-query: unsupported additional args "
            f"{unknown!r}; supported flags: --model/--provider/--toolsets/"
            "--skills/--max-turns/--verbose/--quiet/--yolo "
            "(query flags are ignored so the prompt file always wins)",
            file=sys.stderr,
        )
        sys.exit(2)
    return kwargs


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] in ("-h", "--help"):
        print(__doc__.strip(), file=sys.stderr)
        return 0 if len(sys.argv) > 1 and sys.argv[1] in ("-h", "--help") else 2

    prompt_path = Path(sys.argv[1])
    if not prompt_path.is_file():
        print(f"anvil-hermes-query: prompt file not found: {prompt_path}", file=sys.stderr)
        return 1

    query = prompt_path.read_text(encoding="utf-8")
    kwargs = _load_additional_kwargs()
    kwargs["query"] = query
    kwargs["quiet"] = True

    return _run_native(kwargs)


@contextlib.contextmanager
def _discard_native_stdout():
    """Discard display output, including cached console streams and child FD 1.

    This is suppression, not parsing terminal text for a guessed final answer.
    Keep stderr available for native operational diagnostics.
    """
    sys.stdout.flush()
    saved_fd = os.dup(1)
    try:
        with open(os.devnull, "w", encoding="utf-8") as sink:
            os.dup2(sink.fileno(), 1)
            with contextlib.redirect_stdout(sink):
                yield
                sys.stdout.flush()
    finally:
        sys.stdout.flush()
        os.dup2(saved_fd, 1)
        os.close(saved_fd)


def _run_native(kwargs: dict[str, Any]) -> int:
    """Observe only the CLI's own native conversation completion boundary.

    Hermes v2026.7.7.2 quiet mode calls its initialized agent's
    run_conversation(), reads final_response, then exits with the native status.
    Wrapping that one instance preserves native routing, credentials, skills,
    sessions, tools and cleanup without capturing independent child agents.
    """
    completion: dict[str, Any] = {}
    observed_agents: set[int] = set()
    code = 0
    provider_unavailable = False
    try:
        with _discard_native_stdout():
            import cli

            original_cli = cli.HermesCLI

            class FinalAnswerCLI(original_cli):
                def _ensure_runtime_credentials(self):
                    nonlocal provider_unavailable
                    ready = super()._ensure_runtime_credentials()
                    provider_unavailable = not ready
                    return ready

                def _init_agent(self, *args, **init_kwargs):
                    initialized = super()._init_agent(*args, **init_kwargs)
                    if initialized and self.agent is not None and id(self.agent) not in observed_agents:
                        observed_agents.add(id(self.agent))
                        native_run = self.agent.run_conversation
                        # quiet mode already disables text/tool display callbacks;
                        # Hermes leaves its reasoning display callback connected.
                        self.agent.reasoning_callback = None

                        @functools.wraps(native_run)
                        def observe_final(*run_args, **run_kwargs):
                            result = native_run(*run_args, **run_kwargs)
                            completion.clear()
                            if isinstance(result, dict):
                                text = result.get("final_response")
                                if isinstance(text, str) and text.strip() and not result.get("failed") and not result.get("partial"):
                                    completion["text"] = text
                            return result

                        self.agent.run_conversation = observe_final
                    return initialized

            cli.HermesCLI = FinalAnswerCLI
            try:
                cli.main(**kwargs)
            finally:
                cli.HermesCLI = original_cli
    except SystemExit as exc:
        code = exc.code if isinstance(exc.code, int) else (0 if exc.code is None else 1)
    except KeyboardInterrupt:
        code = 130
    except Exception:
        print("anvil-hermes-query: native Hermes execution failed", file=sys.stderr)
        return 1

    if provider_unavailable:
        print(json.dumps({"type": "anvil.hermes.error", "version": 1, "code": "provider_configuration_unavailable"}), flush=True)
        return code or 1
    if code != 0:
        return code
    if "text" not in completion:
        print("anvil-hermes-query: Hermes returned no complete final answer", file=sys.stderr)
        return 1
    print(json.dumps({"type": "anvil.hermes.final", "version": 1, "role": "assistant", "text": completion["text"]}, ensure_ascii=False), flush=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
