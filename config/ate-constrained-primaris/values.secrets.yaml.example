# Copy to values.secrets.yaml (gitignored) and rotate before render.
# Do not commit the copy. Do not reuse chart default rustfsadmin.
#
#   cp config/ate-constrained-primaris/values.secrets.yaml.example \
#      config/ate-constrained-primaris/values.secrets.yaml
#
# These keys are written into the atelet env and the rustfs-bucket-init Job
# by the upstream chart. They must never land in git, status, logs, or
# console/API JSON.

rustfs:
  accessKey: ROTATE_BEFORE_RENDER
  secretKey: ROTATE_BEFORE_RENDER
